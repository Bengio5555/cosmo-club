# ─── Sentry (error monitoring) ───────────────────────────────────────
# DSN is the public ingestion URL — safe to ship in client bundles.
NEXT_PUBLIC_SENTRY_DSN=https://0d722a19bec58a7e3ac1044d563981a5@o4511501860077568.ingest.de.sentry.io/4511501863092304
# Auth token: only required at BUILD TIME on Vercel so source maps
# are uploaded and stack traces are symbolicated. Get it from
# Sentry → Settings → Account → User Auth Tokens (scope: project:write).
# DO NOT commit. Missing token = build still succeeds, just minified
# stack traces in Sentry.
SENTRY_AUTH_TOKEN=
